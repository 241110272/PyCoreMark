# PyCoreMark Cluster Configuration

# Coordinator Settings
PYCOREMARK_COORDINATOR_HOST=127.0.0.1
PYCOREMARK_COORDINATOR_PORT=8000
PYCOREMARK_GRPC_PORT=50051
PYCOREMARK_TRANSPORT=grpc

# Worker Settings
PYCOREMARK_WORKER_ID=worker-01
PYCOREMARK_WORKER_CORES=4
PYCOREMARK_WORKER_MEMORY_MB=4096
PYCOREMARK_WORKER_FAILURE_RATE=0.0
PYCOREMARK_SIMULATED_NETWORK_DELAY_MS=0.0
PYCOREMARK_NETWORK_FAILURE_RATE=0.0

# Communication and Broker Settings
PYCOREMARK_BROKER_URL=memory://
PYCOREMARK_DATABASE_URL=sqlite:///pycoremark.db
# Optional shared token. If enabled, set the same value on coordinator,
# workers, and remote CLI clients. HTTP traffic is not encrypted.
# PYCOREMARK_REGISTRATION_AUTH_TOKEN=replace-with-a-long-random-secret

# Heartbeat & Failure Detection (in seconds)
PYCOREMARK_HEARTBEAT_INTERVAL=2.0
PYCOREMARK_FAILURE_TIMEOUT=6.0

# Fault Tolerance
PYCOREMARK_MAX_RETRIES=3

# Monitoring
PYCOREMARK_METRICS_INTERVAL=1.0

# Logging
PYCOREMARK_LOG_LEVEL=INFO

